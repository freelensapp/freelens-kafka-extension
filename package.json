{
  "name": "@freelensapp/kafka-extension",
  "version": "2.0.0",
  "description": "Freelens extension for Apache Kafka",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freelensapp/freelens-kafka-extension.git",
    "directory": "."
  },
  "main": "dist/main.js",
  "renderer": "dist/renderer.js",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">= 24.0.0",
    "freelens": "^2.0.0"
  },
  "copyright": "© 2025-2026 Freelens Authors",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Freelens Authors",
    "email": "freelens@freelens.app"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "biome": "pnpm dlx @biomejs/biome@2.6.3",
    "biome:check": "pnpm biome check",
    "biome:fix": "pnpm biome check --fix",
    "biome:migrate": "pnpm biome migrate --write",
    "trunk": "pnpm dlx @trunkio/launcher@1.3.4",
    "trunk:check": "pnpm trunk check",
    "trunk:check:all": "pnpm trunk check --all",
    "trunk:fix": "pnpm trunk check --fix",
    "trunk:fix:all": "pnpm trunk check --fix --all",
    "lint": "pnpm lint:check",
    "lint:check": "pnpm biome:check",
    "lint:fix": "pnpm biome:fix",
    "knip": "pnpm dlx knip@6.41.0 --dependencies --files --no-gitignore --no-config-hints",
    "knip:check": "pnpm \"/^knip:(development|production)\\$/\"",
    "knip:development": "pnpm knip",
    "knip:production": "pnpm knip --production --strict",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "type:check": "pnpm type:check:sources && pnpm type:check:tests && pnpm type:check:tooling && pnpm type:check:integration && pnpm type:check:environments",
    "type:check:sources": "tsc -p src/main && tsc -p src/renderer",
    "type:check:tests": "tsc -p src/tsconfig.json",
    "type:check:tooling": "tsc -p tsconfig.json",
    "type:check:integration": "tsc -p integration",
    "type:check:environments": "tsc -p environment-tests/tsconfig.main.json && tsc -p environment-tests/tsconfig.renderer.json && tsc -p environment-tests",
    "build": "vite build && vite build --mode main && pnpm check:main",
    "check:main": "node scripts/check-main.mjs",
    "dev": "pnpm \"/^dev:(renderer|main)\\$/\"",
    "dev:main": "vite build --watch --mode main",
    "dev:renderer": "vite build --watch --no-emptyOutDir",
    "bump-version": "pnpm version --no-commit-hooks --no-git-checks --no-git-tag-version",
    "pack:dev": "pnpm bump-version prerelease && pnpm build && pnpm clean:tgz && pnpm pack && pnpm dlx shx@0.4.0 ls \"$PWD/*.tgz\"",
    "clean": "pnpm clean:dist",
    "clean:dist": "pnpm dlx shx@0.4.0 rm -rf dist",
    "clean:dts": "pnpm dlx shx@0.4.0 rm -f \"src/**/*.d.scss.ts\"",
    "clean:node_modules": "pnpm dlx shx@0.4.0 rm -rf node_modules",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\"",
    "clean:all": "pnpm \"/^clean:(dist|dts|node_modules|tgz)\\$/\"",
    "mcp:app": "bash scripts/start-playwright-mcp-app.sh",
    "demo:up": "node scripts/demo.mjs up",
    "demo:down": "node scripts/demo.mjs down",
    "demo:status": "node scripts/demo.mjs status",
    "lab:up": "bash scripts/lab.sh up",
    "lab:down": "bash scripts/lab.sh down",
    "lab:status": "bash scripts/lab.sh status",
    "lab:apply": "bash scripts/lab.sh apply",
    "lab:delete": "bash scripts/lab.sh delete",
    "lab:freelens": "bash scripts/lab-freelens.sh",
    "kafka:up": "docker compose -f test/e2e/docker-compose.yml up -d --wait",
    "kafka:down": "docker compose -f test/e2e/docker-compose.yml down -v",
    "itest": "tsx test/e2e/integration.local.ts",
    "kind:up": "bash scripts/lab.sh apply base",
    "kind:down": "bash scripts/lab.sh delete base",
    "itest:kind": "tsx test/e2e/integration.kind.ts",
    "kind:disc:up": "bash scripts/lab.sh apply strimzi",
    "kind:disc:down": "bash scripts/lab.sh delete strimzi",
    "kind:real:up": "bash scripts/lab.sh apply strimzi-real",
    "kind:real:down": "bash scripts/lab.sh delete strimzi-real",
    "kind:univ:up": "bash scripts/lab.sh apply external",
    "kind:univ:down": "bash scripts/lab.sh delete external",
    "itest:cache:real": "tsx test/e2e/cache-timing.real.ts",
    "evidence:aggregate": "tsx test/e2e/aggregate-performance-runs.ts",
    "evidence:finalize": "tsx test/e2e/finalize-performance-evidence.ts",
    "evidence:akhq:real": "tsx test/e2e/akhq-timing.real.ts",
    "kafka:direct:up": "docker compose -p freelens-kafka-e2e-direct -f test/e2e/docker-compose.direct.yml up -d --wait && bash test/e2e/setup-direct.sh",
    "kafka:direct:down": "docker compose -p freelens-kafka-e2e-direct -f test/e2e/docker-compose.direct.yml down -v",
    "kafka:acl:up": "docker compose -p freelens-kafka-e2e-acl -f test/e2e/docker-compose.acl.yml up -d --wait",
    "kafka:acl:down": "docker compose -p freelens-kafka-e2e-acl -f test/e2e/docker-compose.acl.yml down -v",
    "itest:acls": "tsx test/e2e/integration.acls.local.ts",
    "itest:messages": "tsx test/e2e/integration.messages.local.ts",
    "itest:groups": "tsx test/e2e/integration.groups.local.ts",
    "itest:health": "tsx test/e2e/integration.health.local.ts",
    "itest:health-fallback": "ALLOW_LOCAL_MUTATING_KAFKA_FIXTURE=1 KAFKA_LOCAL=127.0.0.1:19092 tsx test/e2e/setup-direct-group.ts && KAFKA_LOCAL=127.0.0.1:19092 tsx test/e2e/integration.health-fallback.local.ts",
    "itest:group-batch": "ALLOW_LOCAL_MUTATING_KAFKA_FIXTURE=1 KAFKA_LOCAL=127.0.0.1:19092 tsx test/e2e/integration.group-offset-batch.local.ts",
    "itest:aggregate-worker": "tsx test/e2e/integration.aggregate-health.local.ts",
    "itest:broker-config": "tsx test/e2e/integration.broker-config.local.ts",
    "kafka:auth:up": "docker compose -f test/e2e/docker-compose.auth.yml up -d --wait && bash test/e2e/setup-auth.sh",
    "kafka:auth:down": "docker compose -f test/e2e/docker-compose.auth.yml down -v",
    "itest:security": "tsx test/e2e/integration.security.local.ts",
    "kind:direct:up": "bash scripts/lab.sh apply direct",
    "kind:direct:down": "bash scripts/lab.sh delete direct",
    "kind:auth:up": "bash scripts/lab.sh apply auth",
    "kind:auth:down": "bash scripts/lab.sh delete auth",
    "itest:disc:kind": "tsx test/e2e/integration.discovery.kind.ts",
    "kind:p25:up": "bash scripts/lab.sh apply p25",
    "kind:p25:down": "bash scripts/lab.sh delete p25",
    "itest:p25:kind": "tsx test/e2e/integration.connect.kind.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-provider-node": "^3.972.84",
    "@aws-sdk/util-format-url": "^3.972.48",
    "@smithy/signature-v4": "^5.7.4",
    "avsc": "^5.7.9",
    "kafkajs": "^2.2.4",
    "lz4-asm": "0.4.2",
    "protobufjs": "^7.6.6"
  },
  "devDependencies": {
    "@freelensapp/extensions": "2.0.0",
    "@kubernetes/client-node": "2.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.10.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass-embedded": "1.105.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "lens",
    "openlens",
    "freelens",
    "kafka"
  ],
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
